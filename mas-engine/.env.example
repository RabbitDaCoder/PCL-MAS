# Current dev/testing-tier model matrix (free-tier providers, NOT the final production
# matrix — swap these to production models later via env vars only, no code changes needed).

# Administrative Agent — dev tier: Groq, GPT-OSS 20B
ADMIN_AGENT_PROVIDER=groq
ADMIN_AGENT_MODEL=openai/gpt-oss-20b
ADMIN_AGENT_API_KEY=

# Instructor Agent — dev tier: Groq, GPT-OSS 120B
INSTRUCTOR_AGENT_PROVIDER=groq
INSTRUCTOR_AGENT_MODEL=openai/gpt-oss-120b
INSTRUCTOR_AGENT_API_KEY=

# Lecturer Agent — dev tier: Google AI Studio, Gemini Flash
LECTURER_AGENT_PROVIDER=google
LECTURER_AGENT_MODEL=gemini-flash-latest
LECTURER_AGENT_API_KEY=

# Optional shared fallback if a per-agent key isn't set (dev convenience only)
DEFAULT_PROVIDER=
DEFAULT_API_KEY=

# Memory (cross-session knowledge) — entirely optional. Needs an embedding-capable provider,
# which is NOT the same thing as a chat-completion provider (DeepSeek above, for example, has no
# embeddings endpoint at all). Leave blank and memory silently disables itself everywhere.
# Supported EMBEDDING_PROVIDER values: "openai" (EMBEDDING_MODEL e.g. text-embedding-3-small) or
# "google-generativeai" (EMBEDDING_MODEL e.g. gemini-embedding-001).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

AI_SERVICE_PORT=8000
BACKEND_BASE_URL=http://localhost:4000
ENVIRONMENT=development
